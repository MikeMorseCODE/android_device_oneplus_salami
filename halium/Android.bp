//
// Halium/Droidian device-adaptation files for OnePlus 11 (salami).
// All files installed to /system/etc/halium/; consumed by halium-install.
//

sh_binary {
    name: "halium_fixup_mountpoints",
    filename: "fixup-mountpoints",
    src: "fixup-mountpoints",
    relative_install_path: "../etc/halium",
}

sh_binary {
    name: "halium_usb_rndis_sh",
    filename: "usb-rndis.sh",
    src: "usb-rndis.sh",
    relative_install_path: "../etc/halium",
}

sh_binary {
    name: "halium_flash_all",
    filename: "flash-all.sh",
    src: "flash-all.sh",
    relative_install_path: "../etc/halium",
}

prebuilt_etc {
    name: "halium_lxc_android_conf",
    filename: "lxc-android.conf",
    src: "lxc-android.conf",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_udev_rules",
    filename: "70-salami.rules",
    src: "70-salami.rules",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_prop",
    filename: "halium.prop",
    src: "halium.prop",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_usb_rndis_service",
    filename: "usb-rndis.service",
    src: "usb-rndis.service",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_usb_rndis_network",
    filename: "usb-rndis.network",
    src: "usb-rndis.network",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_ofono_ril_subscription",
    filename: "ril_subscription.conf",
    src: "ril_subscription.conf",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_ofono_phonesim",
    filename: "phonesim.conf",
    src: "phonesim.conf",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_ofono_conf",
    filename: "ofono.conf",
    src: "ofono.conf",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_phoc_ini",
    filename: "phoc.ini",
    src: "phoc.ini",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_pulse_droid_pa",
    filename: "pulse-droid.pa",
    src: "pulse-droid.pa",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_nm_ofono_conf",
    filename: "10-ofono.conf",
    src: "10-ofono.conf",
    sub_dir: "halium",
}

prebuilt_etc {
    name: "halium_nm_connectivity_conf",
    filename: "20-connectivity.conf",
    src: "20-connectivity.conf",
    sub_dir: "halium",
}
