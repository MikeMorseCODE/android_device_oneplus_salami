//
// Halium/Droidian device-adaptation files for OnePlus 11 (salami).
// Installed to /system/etc/halium/ and consumed by halium-install
// when setting up the Droidian rootfs.
//

// fixup-mountpoints must be executable (+x); sh_binary installs as 755.
sh_binary {
    name: "halium_fixup_mountpoints",
    filename: "fixup-mountpoints",
    src: "fixup-mountpoints",
    // relative_install_path is relative to /system/bin/, so ../etc/halium
    // resolves to /system/etc/halium/fixup-mountpoints.
    relative_install_path: "../etc/halium",
}

// lxc-android.conf is a plain config; prebuilt_etc (644) is fine.
prebuilt_etc {
    name: "halium_lxc_android_conf",
    filename: "lxc-android.conf",
    src: "lxc-android.conf",
    sub_dir: "halium",
    // Installs to /system/etc/halium/lxc-android.conf
    // Copied by halium-install to /var/lib/lxc/android/config.
}

// udev rules for Droidian hardware access.
prebuilt_etc {
    name: "halium_udev_rules",
    filename: "70-salami.rules",
    src: "70-salami.rules",
    sub_dir: "halium",
    // Installs to /system/etc/halium/70-salami.rules
    // Copied by halium-install to /lib/udev/rules.d/70-salami.rules.
}
