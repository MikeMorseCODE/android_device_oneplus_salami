//
// Halium/Droidian device-adaptation files for OnePlus 11 (salami).
// All files are installed to /system/etc/halium/ and consumed by
// halium-install when setting up the Droidian rootfs.
//

// fixup-mountpoints must be executable (+x); sh_binary installs as 755.
sh_binary {
    name: "halium_fixup_mountpoints",
    filename: "fixup-mountpoints",
    src: "fixup-mountpoints",
    relative_install_path: "../etc/halium",
}

// usb-rndis.sh must also be executable.
sh_binary {
    name: "halium_usb_rndis_sh",
    filename: "usb-rndis.sh",
    src: "usb-rndis.sh",
    relative_install_path: "../etc/halium",
}

// lxc-android.conf
prebuilt_etc {
    name: "halium_lxc_android_conf",
    filename: "lxc-android.conf",
    src: "lxc-android.conf",
    sub_dir: "halium",
}

// udev rules
prebuilt_etc {
    name: "halium_udev_rules",
    filename: "70-salami.rules",
    src: "70-salami.rules",
    sub_dir: "halium",
}

// halium.prop
prebuilt_etc {
    name: "halium_prop",
    filename: "halium.prop",
    src: "halium.prop",
    sub_dir: "halium",
}

// systemd unit for USB RNDIS gadget
prebuilt_etc {
    name: "halium_usb_rndis_service",
    filename: "usb-rndis.service",
    src: "usb-rndis.service",
    sub_dir: "halium",
}

// systemd-networkd config for usb0 RNDIS interface
prebuilt_etc {
    name: "halium_usb_rndis_network",
    filename: "usb-rndis.network",
    src: "usb-rndis.network",
    sub_dir: "halium",
}
